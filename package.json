{
  "name": "ro-eoq-suite",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "EOQ Studio — Aplikasi Riset Operasi untuk Model Persediaan EOQ Deterministik (Winston Bab 15)",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:standalone": "tsc -b && vite build --mode standalone && node -e \"require('fs').copyFileSync('standalone/index.html','EOQ-Studio.html')\"",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --noEmit"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "katex": "^0.16.47",
    "lucide-react": "^1.74.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6",
    "recharts": "^2.15.4",
    "zustand": "^4.5.7"
  },
  "devDependencies": {
    "@types/katex": "^0.16.8",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.6.2",
    "postcss": "^8.5.33",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^2.1.9"
  },
  "engines": {
    "node": ">=18"
  }
}